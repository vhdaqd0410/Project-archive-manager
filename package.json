{
  "name": "project-archive-manager",
  "version": "2.7.0",
  "description": "项目档案管理器 — 桌面应用",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.pam.project-archive-manager",
    "productName": "项目档案管理器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "项目档案管理器"
    },
    "portable": {
      "artifactName": "项目档案管理器_v${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "vhdaqd0410",
      "repo": "Project-archive-manager"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "chart.js": "^4.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.0.0",
    "electron-updater": "^6.8.9"
  }
}
